        "# === Top-50 SAE verification + Neuronpedia auto-lookup — apple triple ===\n",
        "# Requires: sae, hf_model, tokenizer, LAYER_HOOK loaded from prior cells\n",
        "\n",
        "import requests\n",
        "\n",
        "LAYER_HOOK = 20\n",
        "\n",
        "NP_BASE = \"https://www.neuronpedia.org/api\"\n",
        "NP_MODEL = \"gemma-2-2b\"\n",
        "NP_SAE = \"20-gemmascope-res-16k\"\n",
        "\n",
        "def np_summary(feat_idx):\n",
        "    url = f\"{NP_BASE}/feature/{NP_MODEL}/{NP_SAE}/{feat_idx}\"\n",
        "    j = requests.get(url, timeout=15).json()\n",
        "    return {\n",
        "        \"explanations\": [(e[\"explanationModelName\"], e[\"description\"])\n",
        "                          for e in j.get(\"explanations\", [])],\n",
        "        \"pos_logits\": list(zip(j[\"pos_str\"], j[\"pos_values\"])),\n",
        "        \"neg_logits\": list(zip(j[\"neg_str\"], j[\"neg_values\"])),\n",
        "        \"max_act\": j[\"maxActApprox\"],\n",
        "        \"frac_nonzero\": j[\"frac_nonzero\"],\n",
        "    }\n",
        "\n",
        "def print_feature_summary(feat_idx):\n",
        "    try:\n",
        "        s = np_summary(feat_idx)\n",
        "    except Exception as e:\n",
        "        print(f\"  F{feat_idx}: FETCH FAILED ({e})\")\n",
        "        return\n",
        "    print(f\"  F{feat_idx}   max_act={s['max_act']:.1f}   fires={s['frac_nonzero']*100:.2f}%\")\n",
        "    for m, d in s[\"explanations\"]:\n",
        "        print(f\"    [{m}] {d}\")\n",
        "    print(f\"    pos logits:\")\n",
        "    for tok, val in s[\"pos_logits\"][:6]:\n",
        "        print(f\"      {val:+.2f}  {tok!r}\")\n",
        "    print(f\"    neg logits:\")\n",
        "    for tok, val in s[\"neg_logits\"][:4]:\n",
        "        print(f\"      {val:+.2f}  {tok!r}\")\n",
        "\n",
        "TARGET_FEATURE = 16331\n",
        "TOP_K_FEATURES = 50\n",
        "\n",
        "apple_triple = {\n",
        "    \"apple_ambiguous\": \"The apple is rotten.\",\n",
        "    \"apple_disambig_fruit\": \"The Granny Smith apple is rotten.\",\n",
        "    \"apple_disambig_company\": \"The Silicon Valley apple is rotten.\",\n",
        "}\n",
        "\n",
        "print(\"=\" * 78)\n",
        "print(f\"APPLE TRIPLE — TOP-{TOP_K_FEATURES} SAE FEATURES AT L{LAYER_HOOK}\")\n",
