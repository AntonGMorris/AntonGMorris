        "# Natural polysemanticity test: does workspace hold multiple senses without prompting?\n",
        "import math\n",
        "\n",
        "polysemantic_prompts = {\n",
        "    # \"bat\" — animal vs sports equipment\n",
        "    \"bat_ambiguous\":       \"The bat is quick.\",\n",
        "    \"bat_disambig_animal\": \"The vampire bat is quick.\",\n",
        "    \"bat_disambig_sport\":  \"The baseball bat is quick.\",\n",
        "\n",
        "    # \"bass\" — fish vs musical instrument vs low sound\n",
        "    \"bass_ambiguous\":       \"The bass was loud.\",\n",
        "    \"bass_disambig_music\":  \"The electric bass was loud.\",\n",
        "    \"bass_disambig_fish\":   \"The largemouth bass was loud.\",\n",
        "\n",
        "    # \"crane\" — bird vs construction equipment\n",
        "    \"crane_ambiguous\":       \"She watched the crane.\",\n",
        "    \"crane_disambig_bird\":   \"She watched the sandhill crane.\",\n",
        "    \"crane_disambig_machine\":\"She watched the construction crane.\",\n",
        "\n",
        "    # \"apple\" — fruit vs tech company\n",
        "    \"apple_ambiguous\":       \"The apple is rotten.\",\n",
        "    \"apple_disambig_fruit\":  \"The Granny Smith apple is rotten.\",\n",
        "    \"apple_disambig_company\":\"The Silicon Valley apple is rotten.\",\n",
        "}\n",
        "\n",
        "LAYER = 20  # the conceptual layer identified in the previous run\n",
        "TOP_K = 50  # deep enough to catch second-sense tokens\n",
        "\n",
        "def deep_readout(prompt, layer=LAYER, top_k=TOP_K):\n",
        "    jlens_logits, _, _ = lens.apply(model, prompt, layers=[layer], positions=[-1])\n",
        "    logits = jlens_logits[layer][0].float()\n",
        "    probs = torch.softmax(logits, dim=-1)\n",
        "    entropy = -(probs * (probs + 1e-12).log()).sum().item() / math.log(2)\n",
        "    sorted_probs, sorted_idx = torch.sort(probs, descending=True)\n",
        "    eff_k_90 = int((torch.cumsum(sorted_probs, dim=0) < 0.9).sum().item() + 1)\n",
        "    top_tokens = [(rank, tokenizer.decode([sorted_idx[rank].item()]), sorted_probs[rank].item())\n",
        "                  for rank in range(top_k)]\n",
        "    return entropy, eff_k_90, top_tokens\n",
        "\n",
        "for name, prompt in polysemantic_prompts.items():\n",
        "    print(\"=\" * 78)\n",
        "    print(f\"[{name}]  {prompt!r}\")\n",
        "    entropy, eff_k_90, tops = deep_readout(prompt)\n",
        "    print(f\"L{LAYER}  entropy={entropy:.2f}b  eff_k_90={eff_k_90}\")\n",
        "    print(f\"Top-{TOP_K}:\")\n",
        "    for rank, tok, prob in tops:\n",
        "        print(f\"  {rank+1:3d}. {prob:.4f}  {tok!r}\")\n",
        "    print()\n"
