    {
      "cell_type": "code",
      "source": [
        "\n",
        "# === Complete J-lens pipeline (one cell): install → load → smoke → fit → readout ===\n",
        "import subprocess, sys\n",
        "\n",
        "# 1. Install jlens\n",
        "subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\",\n",
        "                      \"git+https://github.com/anthropics/jacobian-lens.git\"])\n",
        "\n",
        "import torch, gc, math, time\n",
        "import transformers, jlens\n",
        "from google.colab import userdata\n",
        "from huggingface_hub import login\n",
        "from jlens.examples import load_wikitext_prompts\n",
        "\n",
        "# 2. Cleanup in case of rerun\n",
        "try:\n",
        "    del model, hf_model, lens\n",
        "except NameError:\n",
        "    pass\n",
        "gc.collect()\n",
        "torch.cuda.empty_cache()\n",
        "print(f\"GPU: {torch.cuda.get_device_name(0)}, VRAM at start: {torch.cuda.memory_allocated()/1e9:.2f} GB\")\n",
        "\n",
        "# 3. HF auth (Colab secret)\n",
        "login(token=userdata.get(\"HF_TOKEN\"))\n",
        "\n",
        "# 4. Load Gemma-2-2B-IT with EAGER attention (SDPA breaks jlens autograd)\n",
        "print(\"\\n[Load] Gemma-2-2B-IT with eager attention...\")\n",
        "hf_model = transformers.AutoModelForCausalLM.from_pretrained(\n",
        "    \"google/gemma-2-2b-it\",\n",
        "    dtype=torch.bfloat16,\n",
        "    attn_implementation=\"eager\",\n",
        ").cuda()\n",
        "tokenizer = transformers.AutoTokenizer.from_pretrained(\"google/gemma-2-2b-it\")\n",
        "model = jlens.from_hf(hf_model, tokenizer)\n",
        "print(f\"[Load] Complete. VRAM: {torch.cuda.memory_allocated()/1e9:.2f} GB\")\n",
        "\n",
        "# 5. Smoke test — 5 long literals, 1 layer, tiny params. Should be <30s.\n",
        "smoke_prompts = [\n",
        "    \"In a hole in the ground there lived a hobbit. Not a nasty, dirty, wet hole, filled with the ends of worms and an oozy smell.\",\n",
        "]\n",
        "print(\"\\n[Smoke] Fitting on 5 prompts, 1 layer...\")\n",
        "t0 = time.time()\n",
        "_smoke = jlens.fit(model, smoke_prompts, source_layers=[13], dim_batch=4, max_seq_len=64)\n",
        "print(f\"[Smoke] Complete: {time.time()-t0:.1f}s — toolkit functional, proceeding to full fit\")\n",
        "\n",
        "# 6. Full fit — 100 wikitext prompts, 8 layers\n",
        "print(\"\\n[Full fit] Loading wikitext prompts...\")\n",
        "fit_prompts = load_wikitext_prompts(n_prompts=100)\n",
        "LAYERS_TO_FIT = [3, 6, 10, 13, 16, 20, 23, 24]\n",
        "\n",
        "print(f\"[Full fit] Fitting {len(fit_prompts)} prompts, {len(LAYERS_TO_FIT)} layers (est. 10-20 min)...\")\n",
        "t0 = time.time()\n",
        "lens = jlens.fit(\n",
        "    model, fit_prompts,\n",
        "    source_layers=LAYERS_TO_FIT,\n",
        "    dim_batch=8,\n",
        "    max_seq_len=128,\n",
        "    checkpoint_path=\"/content/jlens_ckpt.pt\",\n",
        ")\n",
        "fit_time = time.time() - t0\n",
        "print(f\"[Full fit] Complete: {fit_time:.1f}s ({fit_time/60:.1f} min). VRAM: {torch.cuda.memory_allocated()/1e9:.2f} GB\")\n",
        "\n",
        "# 7. Save lens\n",
        "lens.save(\"/content/jacobian_lens_gemma2_2b_it.pt\")\n",
        "print(\"[Save] Lens saved to /content/jacobian_lens_gemma2_2b_it.pt\")\n",
        "\n",
        "# 8. Apply to probe prompts — J-lens vs logit-lens comparison\n",
        "prompts_to_probe = {\n",
        "    \"hide_count\":       \"Count to five. Think carefully about your reasoning but only output the numbers.\",\n",
        "    \"verbal_count\":     \"Count from 1 to 5. For each number, first write one sentence explaining what that number represents to you, then write 'Number: N'.\",\n",
        "    \"ambiguous_apple\":  \"The apple is rotten.\",\n",
        "    \"ambiguous_bat\":    \"The bat flew across the field.\",\n",
        "    \"unambiguous_ctrl\": \"The cat sat on the mat.\",\n",
        "}\n",
        "LAYERS_TO_PROBE = [6, 13, 20, 24]\n",
        "TOP_K = 5\n",
        "\n",
        "def readout(logits_vec, tokenizer, top_k=TOP_K):\n",
        "    probs = torch.softmax(logits_vec.float(), dim=-1)\n",
        "    entropy = -(probs * (probs + 1e-12).log()).sum().item() / math.log(2)\n",
        "    peak = probs.max().item()\n",
        "    sorted_probs, _ = torch.sort(probs, descending=True)\n",
        "    eff_k_90 = int((torch.cumsum(sorted_probs, dim=0) < 0.9).sum().item() + 1)\n",
        "    top = torch.topk(probs, top_k)\n",
        "    top_toks = [repr(tokenizer.decode([t.item()])) for t in top.indices]\n",
        "    return entropy, peak, eff_k_90, top_toks\n",
        "\n",
        "print(\"\\n\" + \"=\" * 78)\n",
        "print(\"PROBE READOUTS — J-LENS vs LOGIT-LENS\")\n",
        "print(\"=\" * 78)\n",
        "\n",
        "for name, prompt in prompts_to_probe.items():\n",
        "    print(f\"\\n[{name}]  {prompt!r}\\n\")\n",
        "    jlens_logits, _, _ = lens.apply(model, prompt, layers=LAYERS_TO_PROBE, positions=[-1])\n",
        "    logit_logits, _, _ = lens.apply(model, prompt, layers=LAYERS_TO_PROBE, positions=[-1], use_jacobian=False)\n",
        "    for layer in LAYERS_TO_PROBE:\n",
        "        j_ent, j_peak, j_eff, j_top = readout(jlens_logits[layer][0], tokenizer)\n",
        "        l_ent, l_peak, l_eff, l_top = readout(logit_logits[layer][0], tokenizer)\n",
        "        print(f\"  L{layer:2d}\")\n",
        "        print(f\"    J-LENS  entropy={j_ent:5.2f}b peak={j_peak:.3f} eff_k_90={j_eff:3d}  top: {' '.join(j_top)}\")\n",
        "        print(f\"    LOGIT   entropy={l_ent:5.2f}b peak={l_peak:.3f} eff_k_90={l_eff:3d}  top: {' '.join(l_top)}\")\n"
      ],
