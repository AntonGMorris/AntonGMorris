        "    resid_capture = {}\n",
        "    def hook(module, input, output):\n",
        "        h = output[0] if isinstance(output, tuple) else output\n",
        "        resid_capture[\"h\"] = h.detach()\n",
        "    handle = hf_model.model.layers[LAYER_HOOK].register_forward_hook(hook)\n",
        "    with torch.no_grad():\n",
        "        _ = hf_model(input_ids)\n",
        "    handle.remove()\n",
        "\n",
        "    last_resid = resid_capture[\"h\"][0, -1, :]\n",
        "    feature_acts = sae.encode(last_resid.unsqueeze(0).to(sae.dtype))[0]\n",
