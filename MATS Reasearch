        "# Readouts on 5 probe prompts — J-lens vs logit-lens comparison\n",
        "import math\n",
        "\n",
        "prompts_to_probe = {\n",
        "    \"hide_count\":       \"Count to five. Think carefully about your reasoning but only output the numbers.\",\n",
        "    \"verbal_count\":     \"Count from 1 to 5. For each number, first write one sentence explaining what that number represents to you, then write 'Number: N'.\",\n",
        "    \"ambiguous_apple\":  \"The apple is rotten.\",\n",
        "    \"ambiguous_bat\":    \"The bat flew across the field.\",\n",
        "    \"unambiguous_ctrl\": \"The cat sat on the mat.\",\n",
        "}\n",
        "\n",
        "LAYERS_TO_PROBE = [6, 13, 20, 24]\n",
        "TOP_K = 5\n",
        "\n",
        "def readout(logits_vec, tokenizer, top_k=TOP_K):\n",
        "    probs = torch.softmax(logits_vec.float(), dim=-1)\n",
        "    entropy = -(probs * (probs + 1e-12).log()).sum().item() / math.log(2)\n",
        "    peak = probs.max().item()\n",
        "    sorted_probs, _ = torch.sort(probs, descending=True)\n",
        "    eff_k_90 = int((torch.cumsum(sorted_probs, dim=0) < 0.9).sum().item() + 1)\n",
        "    top = torch.topk(probs, top_k)\n",
        "    top_toks = [repr(tokenizer.decode([t.item()])) for t in top.indices]\n",
        "    return entropy, peak, eff_k_90, top_toks\n",
        "\n",
        "print(\"=\" * 78)\n",
        "print(\"PROBE READOUTS — J-LENS vs LOGIT-LENS\")\n",
        "print(\"=\" * 78)\n",
        "\n",
        "for name, prompt in prompts_to_probe.items():\n",
        "    print(f\"\\n[{name}]  {prompt!r}\\n\")\n",
        "    jlens_logits, _, _ = lens.apply(model, prompt, layers=LAYERS_TO_PROBE, positions=[-1])\n",
        "    logit_logits, _, _ = lens.apply(model, prompt, layers=LAYERS_TO_PROBE, positions=[-1], use_jacobian=False)\n",
        "    for layer in LAYERS_TO_PROBE:\n",
        "        j_ent, j_peak, j_eff, j_top = readout(jlens_logits[layer][0], tokenizer)\n",
        "        l_ent, l_peak, l_eff, l_top = readout(logit_logits[layer][0], tokenizer)\n",
        "        print(f\"  L{layer:2d}\")\n",
        "        print(f\"    J-LENS  entropy={j_ent:5.2f}b peak={j_peak:.3f} eff_k_90={j_eff:3d}  top: {' '.join(j_top)}\")\n",
        "        print(f\"    LOGIT   entropy={l_ent:5.2f}b peak={l_peak:.3f} eff_k_90={l_eff:3d}  top: {' '.join(l_top)}\")\n"
      ],
